DATABASE_URL=postgresql+psycopg://sih:change-me@postgres:5432/sih
REDIS_URL=redis://redis:6379/0
GITHUB_TOKEN=
LOG_LEVEL=INFO

# Détection / publication
BASELINE_DAYS=14
PUBLISH_MIN_HISTORY_DAYS=7
SITE_BASE_URL=https://ton-domaine.example
API_DOMAIN=api.ton-domaine.example
